/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML: NO cachear en edge -> siempre se sirve el último deploy (evita stale
# como el logo atrasado). El navegador revalida en cada visita.
  Cache-Control: public, max-age=0, s-maxage=0, must-revalidate

# Sitemaps: cache 1h (siempre fresco, nunca bloqueante)
/sitemap-*.xml
  Cache-Control: public, max-age=3600, s-maxage=3600

# Favicon & PWA icons — short cache so updates propagate fast
/favicon.svg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/site.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Hashed assets (JS/CSS Astro) — immutable 1 year
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes en /images/ — 30 días + SWR
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Formatos de imagen genéricos — 30 días + SWR
*.svg
  Cache-Control: public, max-age=31536000, immutable

*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.avif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.gif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.json
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

*.woff2
  Cache-Control: public, max-age=31536000, immutable

*.txt
  Cache-Control: public, max-age=3600