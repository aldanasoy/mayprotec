---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Benefits from '../components/home/Benefits.astro';
import WhyUs from '../components/home/WhyUs.astro';
import SafeHeights from '../components/home/SafeHeights.astro';
import InstalacionSeguridad from '../components/home/InstalacionSeguridad.astro';
import InstallTypes from '../components/home/InstallTypes.astro';
import Process from '../components/home/Process.astro';
import Gallery from '../components/home/Gallery.astro';
import Testimonials from '../components/home/Testimonials.astro';
import FAQ, { faqItems } from '../components/home/FAQ.astro';
import ContactForm from '../components/home/ContactForm.astro';

const siteUrl = 'https://mallas-barranquilla.com';

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};

// BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": siteUrl }
  ]
};

// Precios por material — misma matriz que /precios/
const materiales = [
  { material: 'Nylon poliamida', calibre: '~1,0 mm', color: 'Transparente', resistenciaKg: '190', garantia: '7 años', precio: 45900 },
  { material: 'Polietileno multifilamento', calibre: '1,7 mm', color: 'Blanco', resistenciaKg: '290', garantia: '10 años', precio: 49900 },
  { material: 'Polietileno multifilamento', calibre: '1,7 mm', color: 'Beige claro', resistenciaKg: '290', garantia: '10 años', precio: 55900 },
  { material: 'Polietileno multifilamento', calibre: '1,7 mm', color: 'Negro', resistenciaKg: '290', garantia: '10 años', precio: 55900 },
];

// Service Schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Instalación de mallas de seguridad en Barranquilla",
  "description": "Servicio profesional de instalación de mallas de seguridad para balcones, ventanas y terrazas en Barranquilla, Colombia.",
  "provider": { "@type": "LocalBusiness", "name": "Mayprotec", "url": siteUrl },
  "areaServed": { "@type": "City", "name": "Barranquilla" },
  "serviceType": "Instalación de mallas de seguridad",
  "offers": materiales.map(m => ({
    "@type": "Offer",
    "name": `Malla de ${m.material} — ${m.color}`,
    "priceCurrency": "COP",
    "availability": "https://schema.org/InStock",
    "areaServed": "Barranquilla, Colombia",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": m.precio,
      "priceCurrency": "COP",
      "unitText": "m2"
    },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Material", "value": m.material },
      { "@type": "PropertyValue", "name": "Calibre", "value": m.calibre },
      { "@type": "PropertyValue", "name": "Color", "value": m.color },
      { "@type": "PropertyValue", "name": "Resistencia declarada", "value": `hasta ${m.resistenciaKg} kg/m² en el sistema instalado` },
      { "@type": "PropertyValue", "name": "Garantía", "value": m.garantia }
    ]
  }))
};
---

<BaseLayout
  title="Mallas para Balcones en Barranquilla | Mayprotec — Instalación Profesional"
  description="Instala mallas de seguridad para balcones, ventanas y terrazas en Barranquilla. Protege a niños y mascotas. Material anti-UV. Garantía hasta 10 años. Cotización gratis."
  schema={[faqSchema, breadcrumbSchema, serviceSchema]}
>
  <Hero />
  <Benefits />
  <InstallTypes />
  <Gallery />
  <WhyUs />
  <SafeHeights />
  <Process />
  <Testimonials />
  <FAQ />
  <InstalacionSeguridad />
  <ContactForm />
</BaseLayout>
