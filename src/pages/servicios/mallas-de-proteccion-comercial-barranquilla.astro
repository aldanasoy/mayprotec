---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/home/ServiceCard.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://mallas-barranquilla.com" },
      { "@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://mallas-barranquilla.com/servicios" },
      { "@type": "ListItem", "position": 3, "name": "Mallas de protección comercial", "item": "https://mallas-barranquilla.com/servicios/mallas-de-proteccion-comercial-barranquilla" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Mallas de protección comercial en Barranquilla",
    "serviceType": "Cerramientos y protección comercial e industrial",
    "description": "Instalación de mallas de protección para bodegas, depósitos, mezzanines y zonas restringidas en Barranquilla y el Atlántico. Visita técnica y presupuesto empresarial.",
    "areaServed": [
      { "@type": "City", "name": "Barranquilla" },
      { "@type": "State", "name": "Atlántico" }
    ],
    "provider": { "@type": "HomeAndConstructionBusiness", "name": "Mayprotec", "url": "https://mallas-barranquilla.com" },
    "url": "https://mallas-barranquilla.com/servicios/mallas-de-proteccion-comercial-barranquilla",
    "offers": { "@type": "Offer", "priceCurrency": "COP", "description": "Presupuesto empresarial según visita técnica, sin compromiso" },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Instalación de protección comercial",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cerramiento para bodegas y depósitos" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Protección de vacíos, mezzanines y áreas elevadas" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Separación de áreas internas y zonas restringidas" } }
      ]
    },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Material", "value": "Polietileno multifilamento" },
      { "@type": "PropertyValue", "name": "Calibre", "value": "1,7 mm" },
      { "@type": "PropertyValue", "name": "Resistencia declarada", "value": "hasta 290 kg/m² en el sistema instalado" },
      { "@type": "PropertyValue", "name": "Garantía", "value": "10 años" }
    ]
  }
];
---

<BaseLayout
  title="Mallas de Protección Comercial en Barranquilla | Mayprotec"
  description="Mallas de protección para bodegas, depósitos, mezzanines y zonas restringidas en Barranquilla. Instalación adaptada a tu operación. Calcula tu instalación."
  canonical="https://mallas-barranquilla.com/servicios/mallas-de-proteccion-comercial-barranquilla/"
  ogImage="/images/equipo.jpg"
  schema={schema}
>
  <!-- Hero -->
  <section class="py-20 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <a href="/" class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-400 hover:text-brand-dark transition-colors mb-6">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          Volver al inicio
        </a>
        <span class="section-label">Protección deportiva y comercial</span>
        <h1 class="font-display font-bold text-3xl md:text-5xl text-ink mt-3 leading-tight">
          Mallas de Protección Comercial<br />
          <span class="text-brand-dark">en Barranquilla</span>
        </h1>
        <p class="text-ink-600 mt-5 leading-relaxed">
          Instalamos mallas de protección para bodegas, depósitos, mezzanines y zonas
          restringidas en Barranquilla y el Atlántico. Cerramientos pensados para proteger
          mercancía, delimitar áreas y evitar caídas, sin detener la operación de tu negocio.
        </p>
        <ul class="mt-6 space-y-2.5">
          {[
            'Protección de mercancía y zonas restringidas en bodegas y depósitos',
            'Separación de áreas internas sin construir muros',
            'Cerramientos para vacíos, mezzanines y áreas elevadas',
            'Instalación coordinada con el horario de tu operación',
          ].map(f => (
            <li class="flex items-start gap-2.5 text-sm text-ink-700">
              <svg class="mt-0.5 flex-shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B9C85" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {f}
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-4 mt-8">
          <button data-open-lead-modal data-modal-location="servicio-comercial" class="btn-primary cursor-pointer">Calcula tu instalación</button>
          <a href="/#contacto" class="btn-secondary">Ir al formulario de contacto</a>
        </div>
      </div>
      <figure class="relative hidden lg:block">
        <div class="rounded-3xl overflow-hidden shadow-2xl">
          <img src="/images/equipo.jpg" alt="Equipo de instaladores de Mayprotec en un proyecto de protección comercial en Barranquilla" class="w-full h-[480px] object-cover" loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <figcaption class="mt-4 text-xs text-ink-400 text-center">Instalación de mallas de protección comercial en Barranquilla</figcaption>
      </figure>
    </div>
  </section>

  <!-- Por qué -->
  <section class="py-16 md:py-20 bg-ink-200/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="section-label">Protección para tu negocio</span>
        <h2 class="section-title mx-auto mt-2">¿Por qué tu negocio necesita protección comercial?</h2>
        <p class="section-subtitle mx-auto mt-4 text-center">
          Una bodega, depósito o local sin protección adecuada expone mercancía, zonas
          restringidas y áreas elevadas a riesgos que se pueden evitar con un cerramiento bien
          instalado.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { t: 'Protección de mercancía', d: 'Delimita zonas restringidas y evita accesos no autorizados a áreas de almacenamiento.' },
          { t: 'Continuidad operativa', d: 'Instalación adaptada a tu horario y operación, sin detener el trabajo diario del negocio.' },
          { t: 'Presupuesto empresarial', d: 'Cotización clara y por escrito, con visita técnica, para bodegas, oficinas y locales comerciales.' },
        ].map(c => (
          <div class="bg-white rounded-3xl p-7 border border-ink-200/60">
            <h3 class="font-display font-bold text-lg text-ink mb-2">{c.t}</h3>
            <p class="text-sm text-ink-600 leading-relaxed">{c.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Copy SEO -->
  <section class="py-16 md:py-20 bg-white" id="mallas-proteccion-comercial-barranquilla">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="section-label">Protección comercial</span>
        <h2 class="section-title mx-auto mt-2">Mallas de protección comercial en Barranquilla</h2>
      </div>
      <div class="space-y-6 text-ink-600 leading-relaxed text-base md:text-lg">
        <p>
          Las bodegas, depósitos y centros de distribución en Barranquilla tienen necesidades
          distintas a las de un hogar: proteger mercancía, delimitar zonas restringidas y evitar
          caídas en vacíos o mezzanines sin interrumpir la operación diaria. Instalamos malla de
          <strong>polietileno multifilamento</strong> (calibre 1,7 mm), con resistencia declarada
          y probada de hasta 290 kg/m² en el sistema instalado y garantía de 10 años, pensada para
          el uso constante de un entorno comercial.
        </p>
        <p>
          Separamos <strong>áreas internas</strong> — pasillos, zonas de picking, cuartos técnicos
          o zonas restringidas para personal autorizado — sin necesidad de levantar muros ni perder
          flujo de aire o luz natural. En <strong>vacíos, mezzanines y áreas elevadas</strong>, la
          malla actúa como barrera de contención física para evitar caídas de personas o materiales
          entre niveles.
        </p>
        <p>
          Sabemos que una bodega no puede detener su operación por una instalación. Por eso
          coordinamos el trabajo <strong>con tu horario</strong>: turnos nocturnos, fines de semana
          o por secciones, mientras el resto de la operación continúa con normalidad.
        </p>
        <p>
          Toda instalación comercial empieza con una <strong>visita técnica</strong> donde evaluamos
          la estructura, el uso del espacio y el nivel de resistencia necesario, y termina con un
          <strong>presupuesto empresarial</strong> claro, por escrito, ajustado a los metros
          cuadrados reales. Atendemos bodegas, centros de distribución, locales comerciales y
          oficinas en Barranquilla y el Atlántico.
        </p>
      </div>
      <div class="mt-8 text-center">
        <button data-open-lead-modal data-modal-location="servicio-comercial-copy" class="btn-primary cursor-pointer">Calcula tu instalación</button>
      </div>
    </div>
  </section>

  <!-- Zonas de instalación -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="section-label">Dónde la instalamos</span>
        <h2 class="section-title mx-auto mt-2">Bodegas, mezzanines y áreas restringidas</h2>
        <p class="section-subtitle mx-auto mt-4 text-center">
          Cada operación es distinta, por eso definimos el cerramiento según el espacio y el
          uso real de tu negocio.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { t: 'Bodegas y centros de distribución', d: 'Cerramientos para depósitos, protección de mercancía y control de acceso a zonas restringidas.' },
          { t: 'Vacíos, mezzanines y áreas elevadas', d: 'Barreras de contención física para evitar caídas de personas o materiales entre niveles.' },
          { t: 'Locales y oficinas', d: 'Separación de áreas internas y protección de zonas específicas sin construir muros.' },
        ].map(c => (
          <div class="bg-brand-50 rounded-3xl p-7 border border-brand/20">
            <h3 class="font-display font-bold text-lg text-brand-dark mb-2">{c.t}</h3>
            <p class="text-sm text-ink-600 leading-relaxed">{c.d}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-ink-500 mt-10">
        Atendemos empresas, bodegas y locales comerciales en Barranquilla y municipios del
        Atlántico como Soledad, Puerto Colombia y Malambo.
      </p>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-16 md:py-20 bg-ink-200/30">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="section-label">Cómo trabajamos</span>
        <h2 class="section-title mx-auto mt-2">De la visita técnica al presupuesto empresarial</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { n: '1', t: 'Contacto', d: 'Nos cuentas el tipo de operación, el espacio a proteger y el horario disponible para trabajar.' },
          { n: '2', t: 'Visita técnica', d: 'Evaluamos la estructura, el uso del espacio y el nivel de resistencia necesario.' },
          { n: '3', t: 'Presupuesto empresarial', d: 'Recibes una cotización clara por escrito, ajustada a los metros cuadrados reales.' },
          { n: '4', t: 'Instalación', d: 'Trabajamos en el horario acordado, por secciones si tu operación lo requiere.' },
        ].map(s => (
          <div class="bg-white rounded-3xl p-6 border border-ink-200/60">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-brand-dark text-white font-bold">{s.n}</span>
            <h3 class="font-semibold text-ink mt-4">{s.t}</h3>
            <p class="text-sm text-ink-600 mt-2 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Servicios relacionados -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="section-label">También te puede interesar</span>
        <h2 class="section-title mx-auto mt-2">Otras soluciones de protección</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        <ServiceCard
          title="Mallas para canchas deportivas"
          desc="Cerramientos laterales y superiores para canchas de fútbol, fútbol sintético y polideportivos."
          img="/images/proceso.jpg"
          alt="Instalación de malla de contención para cancha deportiva en Barranquilla"
          href="/servicios/mallas-para-canchas-deportivas-barranquilla"
        />
        <ServiceCard
          title="Mallas antipalomas"
          desc="Exclusión física de aves en fachadas, aleros y ductos de locales y edificios comerciales."
          img="/images/galeria-6.jpg"
          alt="Malla antipalomas instalada en edificio comercial en Barranquilla"
          href="/servicios/mallas-antipalomas-barranquilla"
        />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center bg-brand-50 rounded-3xl p-8 md:p-12 border border-brand/20">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-ink mb-3">
        Protege tu operación sin detenerla
      </h2>
      <p class="text-ink-600 mb-6 max-w-xl mx-auto">
        Solicita una visita técnica y calcula tu instalación con un presupuesto empresarial
        ajustado a tu bodega, depósito u oficina en Barranquilla.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <button data-open-lead-modal data-modal-location="servicio-comercial-cta" class="btn-primary cursor-pointer">Calcula tu instalación</button>
        <a href="/servicios" class="btn-secondary">Ver todos los servicios</a>
        <a href="/" class="btn-secondary">Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>
