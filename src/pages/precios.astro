---
import BaseLayout from '../layouts/BaseLayout.astro';

const precios = [
  {
    material: 'Nylon poliamida',
    calibre: '~1,0 mm',
    color: 'Transparente',
    colorHex: '#E9EEEC',
    imagen: '/images/muestra-nylon-poliamida-transparente.jpg',
    resistenciaKg: '190',
    garantia: '7 años',
    precio: 45900,
    popular: false,
  },
  {
    material: 'Polietileno multifilamento',
    calibre: '1,7 mm',
    color: 'Blanco',
    colorHex: '#FFFFFF',
    imagen: '/images/muestra-polietileno-blanco.jpg',
    resistenciaKg: '290',
    garantia: '10 años',
    precio: 49900,
    popular: true,
  },
  {
    material: 'Polietileno multifilamento',
    calibre: '1,7 mm',
    color: 'Beige claro',
    colorHex: '#E3D5B8',
    imagen: '/images/muestra-polietileno-beige.jpg',
    resistenciaKg: '290',
    garantia: '10 años',
    precio: 55900,
    popular: false,
  },
  {
    material: 'Polietileno multifilamento',
    calibre: '1,7 mm',
    color: 'Negro',
    colorHex: '#1A1A1A',
    imagen: '/images/muestra-polietileno-negro.jpg',
    resistenciaKg: '290',
    garantia: '10 años',
    precio: 55900,
    popular: false,
  },
];

const formatCOP = (n: number) => n.toLocaleString('es-CO');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://mallas-barranquilla.com" },
    { "@type": "ListItem", "position": 2, "name": "Precios", "item": "https://mallas-barranquilla.com/precios" }
  ]
};

const serviceMaterialesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Instalación de mallas de seguridad por material y color",
  "serviceType": "Instalación de mallas de seguridad",
  "provider": { "@type": "HomeAndConstructionBusiness", "name": "Mayprotec", "url": "https://mallas-barranquilla.com" },
  "areaServed": [
    { "@type": "City", "name": "Barranquilla" },
    { "@type": "State", "name": "Atlántico" }
  ],
  "offers": precios.map(p => ({
    "@type": "Offer",
    "name": `Malla de ${p.material} — ${p.color}`,
    "priceCurrency": "COP",
    "availability": "https://schema.org/InStock",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": p.precio,
      "priceCurrency": "COP",
      "unitText": "m2"
    },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Material", "value": p.material },
      { "@type": "PropertyValue", "name": "Calibre", "value": p.calibre },
      { "@type": "PropertyValue", "name": "Color", "value": p.color },
      { "@type": "PropertyValue", "name": "Resistencia declarada", "value": `hasta ${p.resistenciaKg} kg/m² en el sistema instalado` },
      { "@type": "PropertyValue", "name": "Garantía", "value": p.garantia }
    ]
  }))
};

const schema = [breadcrumbSchema, serviceMaterialesSchema];
---

<BaseLayout
  title="Precios de mallas de seguridad en Barranquilla | Mayprotec"
  description="Precios por m² instalado de mallas de seguridad en Barranquilla: nylon poliamida y polietileno multifilamento, en varios colores. Cotización gratuita."
  canonical="https://mallas-barranquilla.com/precios/"
  schema={schema}
>
  <!-- Hero Precios -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <span class="section-label">Precios</span>
      <h1 class="section-title mx-auto mt-2">
        Precios de mallas de seguridad<br />
        <span class="text-brand-dark">en Barranquilla</span>
      </h1>
      <p class="section-subtitle mx-auto mt-4 text-center">
        Estos son los precios base por m² instalado, según el material y color que elijas.
        El precio final se confirma después de medir tu espacio, sin sorpresas ni costos ocultos.
      </p>
    </div>
  </section>

  <!-- Precios table -->
  <section class="py-16 bg-ink-200/20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="space-y-4">
        {precios.map(p => (
          <div class={`relative bg-white rounded-2xl p-6 border transition-all ${p.popular ? 'border-brand shadow-lg' : 'border-ink-200/60'}`}>
            {p.popular && (
              <span class="absolute -top-3 left-6 bg-brand-dark text-white text-xs font-semibold px-3 py-1 rounded-full">
                Más solicitado
              </span>
            )}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-start gap-4">
                <img
                  src={p.imagen}
                  alt={`Muestra real de malla en ${p.material.toLowerCase()} color ${p.color.toLowerCase()}`}
                  width="64"
                  height="64"
                  loading="lazy"
                  class="w-16 h-16 rounded-xl object-cover border-2 border-ink-200 flex-shrink-0"
                />
                <div>
                  <h2 class="font-semibold text-ink">{p.material} <span class="text-ink-400 font-normal">— {p.color}</span></h2>
                  <p class="text-xs text-ink-400 mt-1">Calibre {p.calibre} · Resistencia declarada y probada de hasta {p.resistenciaKg} kg/m² en el sistema instalado</p>
                  <p class="text-xs text-ink-400 mt-1">Garantía de {p.garantia}</p>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <p class="text-sm text-ink-400">Desde</p>
                <p class="font-display font-bold text-2xl text-brand-dark">${formatCOP(p.precio)} <span class="text-sm font-normal text-ink-400">COP/m²</span></p>
                <p class="text-xs text-ink-400">instalado</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink-400 mt-4 text-center">Fotos de referencia de muestras físicas reales de cada material — no son renders ni fotos de stock.</p>

      <div class="mt-12 bg-brand-50 rounded-3xl p-8 text-center border border-brand/20">
        <h2 class="font-display font-bold text-2xl text-ink mb-3">¿Quieres un precio exacto?</h2>
        <p class="text-ink-600 mb-6">Hacemos una visita técnica sin costo y te damos el presupuesto exacto al centavo.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contacto" class="btn-primary">Enviar fotos y calcular mi instalación</a>
          <button data-open-lead-modal data-modal-location="precios" class="btn-whatsapp cursor-pointer">
            WhatsApp
          </button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
