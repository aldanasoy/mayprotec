---
// Servicios principales (P1-6): máx 6 tarjetas, separadas por "Por espacio" y
// "Por necesidad". Reduce saturación y no mezcla niveles. "Ver todos" en /servicios.
import ServiceCard from './ServiceCard.astro';

const porEspacio = [
  {
    title: 'Mallas para balcones',
    desc: 'La instalación más solicitada. Cubrimos toda la abertura del balcón con malla tensada, sin perforar paredes externas.',
    img: '/images/espacio-balcon.jpg',
    alt: 'Malla de seguridad instalada en balcón de apartamento en Barranquilla',
    tag: 'Más popular',
    href: '/servicios',
  },
  {
    title: 'Mallas para ventanas',
    desc: 'Protección para ventanas de cualquier tamaño. Ideal en pisos altos donde niños o mascotas pueden asomarse.',
    img: '/images/espacio-ventana.jpg',
    alt: 'Malla de seguridad para ventana en Barranquilla',
    tag: null,
    href: '/servicios',
  },
  {
    title: 'Mallas para terrazas',
    desc: 'Terrazas de casas y penthouses. Sistemas de tensado perimetral que soportan el peso de animales grandes.',
    img: '/images/espacio-terraza.jpg',
    alt: 'Malla de seguridad en terraza de casa en Barranquilla',
    tag: null,
    href: '/servicios',
  },
];
const porNecesidad = [
  {
    title: 'Mallas para niños',
    desc: 'Mallas y barandas anti caídas para balcones, ventanas y escaleras. Protección invisible y de alta resistencia.',
    img: '/images/malla-ninos.jpg',
    alt: 'Malla de seguridad para niños anti caídas en balcón de Barranquilla',
    tag: 'Familias',
    href: '/servicios/malla-para-ninos-barranquilla',
  },
  {
    title: 'Mallas para gatos',
    desc: 'Anti caídas para felinos en balcones, ventanas y terrazas. Material resistente a garras con tensado firme.',
    img: '/images/malla-gatos.png',
    alt: 'Malla de seguridad para gatos instalada en ventana de apartamento en Barranquilla',
    tag: null,
    href: '/servicios/malla-para-gatos-barranquilla',
  },
  {
    title: 'Mallas para perros',
    desc: 'Mallas reforzadas para perros medianos y grandes en balcones, terrazas y patios.',
    img: '/images/malla-perros.png',
    alt: 'Malla de seguridad para perros en balcón de casa en Barranquilla',
    tag: null,
    href: '/servicios/malla-para-perros-barranquilla',
  },
];
---

<section class="py-20 md:py-28 bg-ink-200/30" id="tipos" aria-labelledby="types-heading">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <span class="section-label aos">Qué instalamos</span>
      <h2 id="types-heading" class="section-title aos aos-delay-1 mx-auto">
        Mallas de seguridad para<br />
        <span class="text-brand-dark">cada espacio</span> de tu hogar
      </h2>
      <p class="section-subtitle aos aos-delay-2 mx-auto text-center">
        Protegemos balcones, ventanas y terrazas. Y cuidamos lo que más quieres: niños y mascotas.
      </p>
    </div>

    <!-- Por espacio -->
    <div class="mb-14">
      <h3 class="aos flex items-center gap-2.5 text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">
        <span class="w-6 h-0.5 bg-brand rounded-full" aria-hidden="true"></span>
        Por espacio
      </h3>
      <div class="relative">
        <div
          id="espacio-carousel"
          class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-2
                 -mx-4 px-4 sm:mx-0 sm:px-0
                 md:grid md:grid-cols-3 md:overflow-visible md:pb-0
                 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        >
          {porEspacio.map((t, i) => (
            <div id={['balcones', 'ventanas', 'terrazas'][i]} class={`aos aos-delay-${(i % 3) + 1} snap-start shrink-0 w-[84vw] sm:w-[360px] md:w-auto h-full scroll-mt-24`}>
              <ServiceCard title={t.title} desc={t.desc} img={t.img} alt={t.alt} href={t.href} tag={t.tag} />
            </div>
          ))}
        </div>
        <button
          type="button"
          data-carousel-prev="espacio-carousel"
          class="md:hidden flex items-center justify-center absolute left-1 top-[35%] -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-ink-200/60 text-ink-600 hover:text-brand-dark transition-colors z-10 cursor-pointer"
          aria-label="Anterior"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button
          type="button"
          data-carousel-next="espacio-carousel"
          class="md:hidden flex items-center justify-center absolute right-1 top-[35%] -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-ink-200/60 text-ink-600 hover:text-brand-dark transition-colors z-10 cursor-pointer"
          aria-label="Siguiente"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Por necesidad -->
    <div>
      <h3 class="aos flex items-center gap-2.5 text-sm font-bold uppercase tracking-wider text-brand-dark mb-6">
        <span class="w-6 h-0.5 bg-brand rounded-full" aria-hidden="true"></span>
        Por necesidad
      </h3>
      <div class="relative">
        <div
          id="necesidad-carousel"
          class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-2
                 -mx-4 px-4 sm:mx-0 sm:px-0
                 md:grid md:grid-cols-3 md:overflow-visible md:pb-0
                 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        >
          {porNecesidad.map((t, i) => (
            <div class={`aos aos-delay-${(i % 3) + 1} snap-start shrink-0 w-[84vw] sm:w-[360px] md:w-auto h-full`}>
              <ServiceCard title={t.title} desc={t.desc} img={t.img} alt={t.alt} href={t.href} tag={t.tag} />
            </div>
          ))}
        </div>
        <button
          type="button"
          data-carousel-prev="necesidad-carousel"
          class="md:hidden flex items-center justify-center absolute left-1 top-[35%] -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-ink-200/60 text-ink-600 hover:text-brand-dark transition-colors z-10 cursor-pointer"
          aria-label="Anterior"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button
          type="button"
          data-carousel-next="necesidad-carousel"
          class="md:hidden flex items-center justify-center absolute right-1 top-[35%] -translate-y-1/2 w-10 h-10 rounded-full bg-white shadow-lg border border-ink-200/60 text-ink-600 hover:text-brand-dark transition-colors z-10 cursor-pointer"
          aria-label="Siguiente"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>

    <!-- Ver todos -->
    <div class="mt-12 text-center aos">
      <a href="/servicios" class="btn-secondary inline-flex items-center gap-2 no-print" aria-label="Ver todos los servicios">
        Ver todos los servicios
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
// "Por espacio" / "Por necesidad" carousels (mobile only — grid returns at md:)
function initCarousel(id: string) {
  const track = document.getElementById(id);
  if (!track) return;
  const prevBtn = document.querySelector(`[data-carousel-prev="${id}"]`);
  const nextBtn = document.querySelector(`[data-carousel-next="${id}"]`);
  const cardStep = () => (track.firstElementChild as HTMLElement)?.getBoundingClientRect().width + 24 || 300;
  prevBtn?.addEventListener('click', () => track.scrollBy({ left: -cardStep(), behavior: 'smooth' }));
  nextBtn?.addEventListener('click', () => track.scrollBy({ left: cardStep(), behavior: 'smooth' }));
}
initCarousel('espacio-carousel');
initCarousel('necesidad-carousel');
</script>
