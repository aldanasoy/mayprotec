---
// Barra de confianza (P1-9): 4 columnas compactas, inmediatamente bajo el hero.
// Escudo / Sol / Reloj / WhatsApp — refuerza confianza sin añadir un bloque largo.
const confidence = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: 'Garantía por escrito',
    desc: 'Respaldamos material e instalación 1 año.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
    title: 'Material anti-UV',
    desc: 'Resiste el sol del Caribe sin deformarse.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Instalación rápida',
    desc: 'Mayoría de trabajos listos en 24 horas.',
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.117.554 4.107 1.524 5.836L.051 23.625a.75.75 0 00.918.918l5.818-1.476A11.955 11.955 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>`,
    title: 'Cotización sin compromiso',
    desc: 'Presupuesto gratis, claro y por escrito.',
  },
];
---

<section class="bg-ink-DEFAULT" id="beneficios" aria-label="Garantías y confianza">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px">
      {confidence.map((b, i) => (
        <div
          class={`aos aos-delay-${i+1} flex items-center gap-3.5 py-5 px-4 ${i > 0 ? 'lg:border-l lg:border-white/10' : ''} ${i % 2 === 1 ? 'border-l border-white/10 lg:border-l' : ''}`}
        >
          <div class="w-11 h-11 flex-shrink-0 flex items-center justify-center rounded-xl bg-brand/15 text-brand" set:html={b.icon} />
          <div class="min-w-0">
            <h3 class="text-white font-semibold text-[13px] sm:text-sm leading-tight">{b.title}</h3>
            <p class="text-white/60 text-[11px] sm:text-xs leading-snug mt-0.5">{b.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
