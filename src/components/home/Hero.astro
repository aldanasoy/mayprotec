---
// Hero — Keyword principal: "Mallas para Balcones en Barranquilla"
---

<section
  class="relative flex items-center overflow-hidden bg-white"
  aria-labelledby="hero-heading"
>
  <!-- Background accent -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-brand-50/60"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-brand/8 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-10 w-48 h-48 bg-brand-dark/5 rounded-full blur-2xl"></div>
    <!-- Subtle mesh pattern overlay -->
    <div class="absolute inset-0 opacity-[0.02]" style="background-image:repeating-linear-gradient(0deg,#000 0,#000 1px,transparent 1px,transparent 20px),repeating-linear-gradient(90deg,#000 0,#000 1px,transparent 1px,transparent 20px)"></div>
  </div>

  <div class="relative w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20 lg:py-24">
    <div class="grid lg:grid-cols-[48%_52%] gap-8 md:gap-10 lg:gap-8 items-center">

      <!-- ── Copy ── -->
      <div>
        <!-- Pill badge (sello) -->
        <div class="pill mb-5 aos">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          Instalación profesional en Barranquilla
        </div>

        <!-- H1 — keyword exacto, sin <br> forzados, fluye natural -->
        <h1
          id="hero-heading"
          class="aos aos-delay-1 font-display text-[2rem] sm:text-5xl lg:text-[3.4rem] font-bold
                 text-ink leading-[1.08] tracking-tight"
        >
          Mallas para <span class="text-brand-dark">balcones</span> en Barranquilla
        </h1>

        <p class="aos aos-delay-2 mt-5 text-lg md:text-xl text-ink-600 leading-relaxed max-w-md">
          Protege a tus hijos y mascotas con mallas de seguridad de alta resistencia.
          Instalación profesional, material anti-UV,
          <strong class="text-ink font-semibold">garantía incluida</strong>.
        </p>

        <!-- Trust signals (beneficios) -->
        <ul class="aos aos-delay-3 mt-5 flex flex-wrap gap-x-4 gap-y-2" aria-label="Beneficios clave">
          {[
            'Garantía hasta 10 años',
            'Material anti-UV',
            'Instalación en 24h',
            'Sin perforar fachadas',
          ].map(b => (
            <li class="flex items-center gap-1.5 text-sm text-ink-600">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a"
                   stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {b}
            </li>
          ))}
        </ul>

        <!-- CTAs (apilados full-width en móvil) -->
        <div class="aos aos-delay-4 mt-8 flex flex-col sm:flex-row gap-3">
          <button
            data-open-lead-modal
            data-modal-location="hero"
            class="btn-primary justify-center w-full sm:w-auto cursor-pointer no-print"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.117.554 4.107 1.524 5.836L.051 23.625a.75.75 0 00.918.918l5.818-1.476A11.955 11.955 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
            Cotizar por WhatsApp
          </button>
          <a
            href="/precios"
            class="btn-secondary justify-center w-full sm:w-auto cursor-pointer no-print"
          >
            Ver precios
          </a>
        </div>
      </div>

      <!-- ── Hero Image ── -->
      <div class="relative">
        <!-- Imagen: proporción 4/3, radio uniforme, object-position focal en el centro -->
        <div class="relative rounded-[28px] overflow-hidden shadow-2xl aspect-[4/3] bg-brand-50">
          <img
            src="/images/hero-malla-balcon.jpg"
            alt="Instalación de malla de seguridad en balcón de apartamento en Barranquilla Colombia"
            class="absolute inset-0 w-full h-full object-cover"
            style="object-position: center 40%"
            width="1600"
            height="1200"
            loading="eager"
            decoding="async"
          />
          <!-- Overlay suave inferior para legibilidad de badges -->
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/20 via-transparent to-transparent pointer-events-none"></div>

          <!-- Badge superior (solo 1 elemento flotante alto) -->
          <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm rounded-xl px-3 py-2
                      shadow-md flex items-center gap-2 text-sm">
            <div class="w-2 h-2 bg-brand rounded-full animate-pulse" aria-hidden="true"></div>
            <span class="font-semibold text-ink">Instalación disponible esta semana</span>
          </div>
        </div>

        <!-- Testimonial flotante (desktop, dentro de límites) -->
        <div class="hidden lg:block absolute -right-4 -bottom-5 bg-white rounded-2xl p-4 shadow-xl
                    border border-ink-200/60 max-w-[200px]">
          <div class="flex items-center gap-1 mb-1">
            {[0,0,0,0,0].map(() => (
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <p class="text-xs text-ink font-medium leading-tight">"Instalación impecable, muy profesionales"</p>
          <p class="text-[10px] text-ink-400 mt-1">María T. — El Prado</p>
        </div>

        <!-- Móvil: reseña como tarjeta debajo de la foto, dentro de límites -->
        <div class="lg:hidden mt-4 bg-white rounded-2xl p-4 shadow-md border border-ink-200/60">
          <div class="flex items-center gap-1 mb-1">
            {[0,0,0,0,0].map(() => (
              <svg width="12" height="12" viewBox="0 0 24 24" fill="#F59E0B" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-ink font-medium leading-tight">"Instalación impecable, muy profesionales"</p>
          <p class="text-xs text-ink-400 mt-1">María T. — El Prado</p>
        </div>
      </div>
    </div>
  </div>
</section>
