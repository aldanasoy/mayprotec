---
const works = [
  {
    img: '/images/galeria-1.jpg',
    alt: 'Malla de seguridad instalada en balcón de apartamento en el norte de Barranquilla',
    tipo: 'Malla para balcón',
    barrio: 'Norte, Barranquilla',
    espacio: 'Balcón · Apartamento',
    necesidad: 'Protección anti-caída',
  },
  {
    img: '/images/galeria-2.jpg',
    alt: 'Malla protectora para ventana en edificio residencial de Barranquilla',
    tipo: 'Malla para ventana',
    barrio: 'Riomar, Barranquilla',
    espacio: 'Ventana · Edificio',
    necesidad: 'Protección para gatos',
  },
  {
    img: '/images/galeria-3.jpg',
    alt: 'Terraza protegida con malla de seguridad para mascotas en Barranquilla',
    tipo: 'Malla para terraza',
    barrio: 'Villa Santos, Barranquilla',
    espacio: 'Terraza · Casa',
    necesidad: 'Protección para mascotas',
  },
  {
    img: '/images/galeria-4.jpg',
    alt: 'Instalación de malla en balcón de apartamento con niños en Barranquilla',
    tipo: 'Malla para balcón',
    barrio: 'El Prado, Barranquilla',
    espacio: 'Balcón · Apartamento',
    necesidad: 'Protección para niños',
  },
  {
    img: '/images/galeria-5.jpg',
    alt: 'Malla semi-invisible para balcón en conjunto residencial de Barranquilla',
    tipo: 'Malla premium',
    barrio: 'Altos de Riomar',
    espacio: 'Balcón · Conjunto',
    necesidad: 'Estética + seguridad',
  },
  {
    img: '/images/galeria-6.jpg',
    alt: 'Instalación profesional de malla de seguridad en apartamento de piso alto',
    tipo: 'Malla para balcón alto',
    barrio: 'Bocagrande, Barranquilla',
    espacio: 'Balcón · Piso alto',
    necesidad: 'Protección anti-caída',
  },
];
---

<section class="py-20 md:py-28 bg-ink-200/20" aria-labelledby="gallery-heading">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="section-label aos">Trabajos realizados</span>
      <h2 id="gallery-heading" class="section-title aos aos-delay-1 mx-auto">
        Instalaciones en<br />
        <span class="text-brand-dark">Barranquilla y el Atlántico</span>
      </h2>
      <p class="section-subtitle aos aos-delay-2 mx-auto text-center">
        Trabajos reales en apartamentos, casas y conjuntos. Cada instalación se adapta a tu estructura y necesidad.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
      {works.map((w, i) => (
        <div
          class:list={[
            'group relative overflow-hidden rounded-2xl aspect-square bg-brand-50 aos',
            i < 2 ? '' : 'aos-delay-1',
          ]}
        >
          <img
            src={w.img}
            alt={w.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
          <!-- Overlay con metadata -->
          <div class="absolute inset-0 bg-gradient-to-t from-ink-DEFAULT/85 via-ink-DEFAULT/20 to-transparent
                      opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300 flex items-end">
            <div class="p-3.5 md:p-4 w-full">
              <p class="text-white font-semibold text-sm leading-tight">{w.tipo}</p>
              <p class="text-white/80 text-[11px] md:text-xs mt-0.5 flex items-center gap-1">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {w.barrio}
              </p>
              <span class="inline-block mt-1.5 text-[10px] md:text-xs bg-white/15 backdrop-blur-sm text-white px-2 py-0.5 rounded-full">
                {w.espacio}
              </span>
              <span class="inline-block mt-1.5 ml-1.5 text-[10px] md:text-xs bg-brand/90 text-white px-2 py-0.5 rounded-full">
                {w.necesidad}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10 aos">
      <a href="/galeria" class="btn-secondary inline-flex items-center gap-2 no-print">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
        Ver galería completa
      </a>
    </div>
  </div>
</section>

