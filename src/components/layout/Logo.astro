---
// Mayprotec — Logo unificado
// Marca (mark) + wordmark "Mayprotec" como paths VECTORIALES (Manrope 800),
// 100% independiente de fuentes web → se ve idéntico en todos los dispositivos.
// variant "dark"  -> para fondos claros (header, blanco): texto verde oscuro
// variant "light" -> para fondos oscuros (footer): texto blanco
interface Props {
  width?: number;
  height?: number;
  variant?: 'dark' | 'light';
  class?: string;
}
const { width = 190, height = 44, variant = 'dark', class: className = '' } = Astro.props;
const textFill    = variant === 'light' ? '#ffffff' : '#1B3D2A';
const accentFill  = variant === 'light' ? '#10B981' : '#059669';
---

<a
  href="/"
  class:list={['inline-flex items-center gap-2.5 no-print', className]}
  style="flex-shrink:0; text-decoration:none"
  aria-label="Mayprotec - Instalación de mallas de seguridad en Barranquilla"
>
  <!-- Mark: malla → M en shield -->
  <svg
    width={height}
    height={height}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    style="flex-shrink:0"
  >
    <rect width="40" height="40" rx="10" fill="#16a34a"/>
    <g opacity="0.22" stroke="white" stroke-width="0.7">
      <line x1="6" y1="13" x2="34" y2="13"/>
      <line x1="6" y1="19" x2="34" y2="19"/>
      <line x1="6" y1="25" x2="34" y2="25"/>
      <line x1="13" y1="8" x2="13" y2="32"/>
      <line x1="20" y1="8" x2="20" y2="32"/>
      <line x1="27" y1="8" x2="27" y2="32"/>
    </g>
    <path d="M9 29V12L14.5 12L20 22L25.5 12H31V29H27V17.5L21.2 27.5H18.8L13 17.5V29H9Z" fill="white"/>
  </svg>

