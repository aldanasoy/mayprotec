---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="bg-brand-dark text-white">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="mb-5">
          <Logo variant="light" width={185} height={40} />
        </div>
        <p class="text-white/80 text-sm leading-relaxed max-w-xs">
          Empresa especializada en instalación de mallas de seguridad para balcones, ventanas y terrazas en Barranquilla y el Atlántico.
        </p>
        <div class="mt-6 space-y-2 text-sm">
          <a href="tel:+573024249707" class="flex items-center gap-2 text-white/80 hover:text-white transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="flex-shrink-0"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.91 8.08a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            +57 302 424 9707
          </a>
          <p class="flex items-center gap-2 text-white/80">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="flex-shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            info@mallas-barranquilla.com
          </p>
          <a href="https://maps.app.goo.gl/G1GTuDW8YxBG8Jv9A" target="_blank" rel="noopener" class="flex items-center gap-2 text-white/80 hover:text-white transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Cl. 93 #71-49 LOCAL L2-211, Barranquilla, Atlántico
          </a>
        </div>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-white/90 mb-4">Servicios</h3>
        <ul class="space-y-2 text-sm text-white/80">
          {[
            ['/servicios', 'Todos los servicios'],
            ['/servicios/malla-para-gatos-barranquilla', 'Malla para gatos'],
            ['/servicios/malla-para-perros-barranquilla', 'Malla para perros'],
            ['/servicios/malla-para-ninos-barranquilla', 'Malla para niños'],
            ['/#balcones', 'Mallas para balcones'],
            ['/#ventanas', 'Mallas para ventanas'],
            ['/#terrazas', 'Mallas para terrazas'],
            ['/precios', 'Ver precios'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="hover:text-brand-light transition-colors duration-200">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-white/90 mb-4">Empresa</h3>
        <ul class="space-y-2 text-sm text-white/80">
          {[
            ['/nosotros',  'Nosotros'],
            ['/galeria',   'Galería de trabajos'],
            ['/blog',      'Blog'],
            ['/contacto',  'Contacto'],
            ['/politica-privacidad', 'Privacidad'],
          ].map(([href, label]) => (
            <li>
              <a href={href} class="hover:text-brand-light transition-colors duration-200">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/75">
      <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <p>&copy; {year} Mayprotec. Todos los derechos reservados.</p>
        <button
          data-open-lead-modal
          data-modal-location="footer"
          class="bg-brand-primary hover:bg-brand-dark text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 whitespace-nowrap"
          aria-label="Abrir modal de WhatsApp"
        >
          <img src="/images/whatsapp-logo.svg" alt="WhatsApp" width="16" height="16" loading="lazy" />
          WhatsApp: +57 302 424 9707
        </button>
      </div>
      <p class="text-xs">Mallas para balcones en Barranquilla — Instalación profesional con garantía</p>
    </div>
  </div>
</footer>
